# DEMO / SYNTHETIC DATA ONLY. Never use real patient information.

# ---------------------------------------------------------------------------
# Default profile: SMART Health IT sandbox (launch.smarthealthit.org)
# ---------------------------------------------------------------------------
# Sandbox compatibility note (see README → "Sandbox compatibility findings"):
# The plain URL https://launch.smarthealthit.org/v/r4/fhir works for discovery
# and as the iss of an EHR launch (/launch), but the SMART launcher REJECTS a
# standalone authorization request against it:
#   error=invalid_request "Invalid launch options: SyntaxError: Unexpected end of JSON input"
# The launcher reads standalone-launch settings from the base64url "sim" URL
# segment below. Decoded, the segment is:
#   [3,"","","NONE",0,0,0,"","http://localhost:3001/callback","oauth-demo-app","","","","",0,2,""]
#   = patient-standalone launch, patient login + consent screens shown,
#     registered redirect_uri and client_id, public client, PKCE always required.
# Discovery still runs against this URL; no endpoint is hardcoded.
FHIR_BASE_URL=https://launch.smarthealthit.org/v/r4/sim/WzMsIiIsIiIsIk5PTkUiLDAsMCwwLCIiLCJodHRwOi8vbG9jYWxob3N0OjMwMDEvY2FsbGJhY2siLCJvYXV0aC1kZW1vLWFwcCIsIiIsIiIsIiIsIiIsMCwyLCIiXQ/fhir
CLIENT_ID=oauth-demo-app
CLIENT_SECRET=
REDIRECT_URI=http://localhost:3001/callback
SCOPES=openid fhirUser launch/patient patient/Patient.read patient/Observation.read offline_access
PORT=3001
SESSION_SECRET=replace-me

# Where the React UI runs. The server sends the browser here after /callback.
# Use http://localhost:3001 when running the production build (npm run build && npm start).
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Epic sandbox profile: same code, environment variables only.
# Register the app at https://fhir.epic.com first (see README → "Epic profile").
# ---------------------------------------------------------------------------
# FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
# CLIENT_ID=your-epic-non-production-client-id
# CLIENT_SECRET=only-if-registered-as-a-confidential-client
# REDIRECT_URI=http://localhost:3001/callback
# SCOPES=openid fhirUser launch/patient patient/Patient.read patient/Observation.read offline_access
